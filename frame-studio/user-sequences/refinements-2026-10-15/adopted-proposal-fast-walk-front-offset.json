26-10-14T22:26:10.187Z\"},{\"actor\":\"ai\",\"kind\":\"front-leg-phase-offset\",\"sourceFrameId\":\"5d086239-b7d5-4e0a-8f22-1639be262969\",\"offset\":4,\"mask\":{\"x\":11,\"y\":19,\"width\":13,\"height\":5},\"at\":\"2026-10-14T22:26:10.187Z\"}],\"role\":\"cycle\",\"metadata\":{\"category\":\"walk\",\"tags\":[\"walk\"],\"description\":\"Original four-frame gait and head bob, untouched. Paw markers and movement share the same cell clock.\"},\"parentId\":\"02b84a68-7189-428f-aa48-67805ac789f8\"}],\"wip\":false,\"gait\":{\"status\":\"proposal\",\"frontLegOffsetFrames\":4,\"sourceProjectId\":\"6cfeeb8e-959a-4d04-b3cf-173d8093f0dc\",\"mask\":{\"x\":11,\"y\":19,\"width\":13,\"height\":5},\"runtimeEnabled\":false},\"workQueue\":{\"version\":1,\"repository\":\"Stick-Pet-Card\",\"selectedId\":\"vertical-up\",\"tasks\":[{\"id\":\"vertical-up\",\"title\":\"Straight-up jump\",\"category\":\"jump\",\"priority\":\"high\",\"tags\":[\"vertical\",\"up\",\"airborne\"],\"instructions\":\"Create a distinct straight-up airborne pose. Keep the body compact and legs beneath him; avoid the diagonal forward-reaching silhouette. Preserve the intended facing on a vertical jump. Start with one missing airborne frame, using existing takeoff and landing frames as onion references.\",\"status\":\"todo\",\"frameIds\":[],\"notes\":\"\",\"outputs\":[]},{\"id\":\"vertical-down\",\"title\":\"Straight-down drop\",\"category\":\"jump\",\"priority\":\"high\",\"tags\":[\"vertical\",\"down\",\"airborne\"],\"instructions\":\"Create a distinct straight-down airborne pose with the feet prepared beneath the body. Preserve facing rather than implying a sideways leap or backwards motion. Start with one missing airborne frame; compare against existing descent preparation and landing crouch.\",\"status\":\"todo\",\"frameIds\":[],\"notes\":\"\",\"outputs\":[]},{\"id\":\"look-down\",\"title\":\"Look down from a perch\",\"category\":\"idle\",\"priority\":\"high\",\"tags\":[\"look-down\",\"card-edge\"],\"instructions\":\"Lower the head to inspect a card or landing below. Keep the planted paw cells fixed and allow the body/tail to overhang. Use the sitting/perch frames as references.\",\"status\":\"todo\",\"frameIds\":[],\"notes\":\"\",\"outputs\":[]},{\"id\":\"horizontal-refine\",\"title\":\"Refine horizontal leap\",\"category\":\"jump\",\"priority\":\"normal\",\"tags\":[\"horizontal\",\"airborne\"],\"instructions\":\"Refine the approved AI horizontal flight pose. Keep a level back, forward head, trailing tail and gathered legs. Human pixel edits to the AI source make a mixed-origin frame; retain its lineage. No planted contact anchor while airborne.\",\"status\":\"todo\",\"frameIds\":[],\"notes\":\"\",\"outputs\":[]},{\"id\":\"walk-head\",\"title\":\"Refine independent walk heads\",\"category\":\"walk\",\"priority\":\"normal\",\"tags\":[\"walk\",\"head-bob\"],\"instructions\":\"Review the high/low head combinations. Improve the head/neck seam if needed while leaving leg frames and every planted paw marker unchanged. Compare original and half-time head bobbing at the same walking speed.\",\"status\":\"todo\",\"frameIds\":[],\"notes\":\"\",\"outputs\":[]},{\"id\":\"sitting-glance\",\"title\":\"Sitting head glance\",\"category\":\"idle\",\"priority\":\"later\",\"tags\":[\"sit\",\"look\"],\"instructions\":\"Explore a small head turn toward a nearby object without flipping the whole body. Audit the existing turn/idle catalogue before drawing new pixels; keep bearing paws in their source cells.\",\"status\":\"todo\",\"frameIds\":[],\"notes\":\"\",\"outputs\":[]}]},\"catalogueRevision\":4,\"preferredFrame\":0}}","etag":"94f6e2a2e0ac1d8fc4434f9a2c9994073a17cdadae2e53365f027558d9f1a7fd","customMetadata":{"projectId":"proposal-fast-walk-front-offset","name":"Walking · faster · front-leg phase","savedAt":"2026-10-15T08:20:19.546Z","deletedAt":"","ready":"0"}}